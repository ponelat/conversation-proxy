{
  "name": "conversation-proxy",
  "version": "0.1.0",
  "description": "A small, observable proxy between your app and an LLM provider. Runs standalone or embeds in a Node/Next.js server.",
  "license": "Apache-2.0",
  "author": "ponelat <jponelat@gmail.com>",
  "homepage": "https://github.com/ponelat/conversation-proxy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponelat/conversation-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/ponelat/conversation-proxy/issues"
  },
  "keywords": [
    "llm",
    "openai",
    "proxy",
    "observability",
    "conversation",
    "context",
    "hono",
    "agents"
  ],
  "type": "module",
  "bin": {
    "conversation-proxy": "./dist/main.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "skills",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts serve",
    "serve": "tsx src/main.ts serve",
    "cli": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "cross-env CP_TEST_PG=1 vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.0",
    "js-tiktoken": "^1.0.15",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "cross-env": "^7.0.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  }
}
