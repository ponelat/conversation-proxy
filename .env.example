# conversation-proxy configuration. Copy to .env and fill in.
# All settings are env-driven (12-factor); no code change to swap backends.

# --- Server -----------------------------------------------------------------
CP_PORT=8787
CP_AGENTS_DIR=./agents

# --- Storage ----------------------------------------------------------------
# Backend: "memory" (default, non-durable) or "postgres".
CP_STORE=memory
# Required when CP_STORE=postgres. The service isolates its tables in a
# dedicated schema (conversation_proxy) on whatever DB this points at.
CP_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Migration mode: "command" (run `migrate` yourself) or "startup-with-lock".
CP_MIGRATE_MODE=command

# --- Provider ---------------------------------------------------------------
# Provider: "openai" (real) or "fake" (deterministic, for local/dev/tests).
CP_PROVIDER=fake
CP_OPENAI_API_KEY=
CP_MODEL=gpt-4o-mini

# --- Auth (D9) --------------------------------------------------------------
# Control plane bearer token (POST /agents/:agent/messages, etc.).
CP_API_KEY=dev-control-token
# Debug plane is OFF unless explicitly enabled; it exposes full prompt context.
CP_DEBUG_ENABLED=false
CP_DEBUG_TOKEN=dev-debug-token
